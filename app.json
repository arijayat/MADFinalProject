{
  "expo": {
    "name": "STEM Learning Lab",
    "slug": "stem-learning-lab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "finalproj",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.binanusantara.stemlearninglab",
      "supportsTablet": true,
      "infoPlist": {
        "NSMotionUsageDescription": "STEM Learning Lab uses your phone’s motion sensors to measure chest breathing, movement smoothness, and vibration during science activities.",
        "NSLocationWhenInUseUsageDescription": "STEM Learning Lab uses your location to record your school when you create an account."
      }
    },
    "android": {
      "package": "com.binanusantara.stemlearninglab",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow STEM Learning Lab to use the microphone to measure sound levels for science activities."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow STEM Learning Lab to use the camera to record parachute drops and measure fall times.",
          "microphonePermission": "Allow STEM Learning Lab to record audio with drop videos.",
          "recordAudioAndroid": true
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow STEM Learning Lab to upload photos of your revised parachute design.",
          "cameraPermission": "Allow STEM Learning Lab to photograph your revised parachute design."
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow STEM Learning Lab to use your location to record your school when creating an account."
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3235268367307003~9694560177",
          "iosAppId": "ca-app-pub-3235268367307003~6299613798"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d5fa29ae-4296-4919-befa-6357b933bef6"
      }
    }
  }
}
