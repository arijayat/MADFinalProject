# Copy this file to `.env` and paste values from Firebase Console:
# Project settings (gear) → Your apps → Web app → SDK setup and configuration
#
# After editing, restart Expo:  npx expo start -c

EXPO_PUBLIC_FIREBASE_API_KEY=paste_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=paste_sender_id_here
EXPO_PUBLIC_FIREBASE_APP_ID=paste_app_id_here
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=paste_measurement_id_here
